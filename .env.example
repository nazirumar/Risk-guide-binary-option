# ──────────────────────────────────────────────────────────────────────────────
# RiskGuard environment template — copy to `.env` and fill in real values.
# Never commit the real `.env` file.
# ──────────────────────────────────────────────────────────────────────────────

# Database (SQLite for local sandbox dev by default).
# To switch to Postgres, set this to the connection string of your Postgres instance
# (e.g. postgres://riskguard:riskguard_dev_password@localhost:5432/riskguard).
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Next.js / Auth.js
NEXTAUTH_URL="http://localhost:3000"
# Generate with: `openssl rand -base64 32` (or `bun run scripts/generate-secret.ts`)
NEXTAUTH_SECRET="dev-only-secret-change-me-in-production"

# ─── AI provider (Phase 30) ──────────────────────────────────────────────────
# Groq is the default when GROQ_API_KEY is set. Server-only: never expose in
# NEXT_PUBLIC_* vars or send to the browser.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Optional: vision-capable Groq model for statement-screenshot OCR (Phase 30.3).
# Leave empty to require pasted OCR/PDF text in /app/import. Server-only.
GROQ_VISION_MODEL=""
GROQ_TIMEOUT_MS="20000"
# Legacy fallback, used only when GROQ_API_KEY is empty.
ANTHROPIC_API_KEY=""
# Phase 30.2 — daily per-user coach message quota (default 20, clamped 1-200).
COACH_MAX_MESSAGES_PER_DAY="20"

# Phase 30.3 — statement import. Max upload bytes (default 2 MiB, clamped 1 KiB–10 MiB).
IMPORT_MAX_BYTES="2097152"
# Optional: where uploaded statement bytes are archived by the storage layer.
# Defaults to ./.uploads in the project (served at /api/upload/*).
UPLOAD_DIR=""
UPLOAD_URL_PREFIX=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Phase 25: renamed from GOOGLE_CLIENT_ID/SECRET → AUTH_GOOGLE_ID/SECRET per
# spec. The old names still work for backward compatibility, but new
# deployments should use the AUTH_GOOGLE_* names.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# (Deprecated aliases — still honored by src/lib/auth.ts but discouraged.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (transactional email) — https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="RiskGuard <onboarding@resend.dev>"

# Cron + Telegram — /api/cron/* routes, news briefing (Phase 30.4) and alerts.
# CRON_SECRET gates every /api/cron/* endpoint (Bearer or ?token=).
CRON_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# Upstash Redis (rate limiting) — https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# App config
APP_NAME="RiskGuard"
APP_TIMEZONE="UTC"
DEFAULT_BASE_CURRENCY="USD"
NODE_ENV="development"

# ──────────────────────────────────────────────────────────────────────────────
# Phase 26 — Market data provider
# ──────────────────────────────────────────────────────────────────────────────
# Provider switch ("deriv" | "twelvedata").
# Deriv is the default for this phase: OANDA is not available in Nigeria.
# (Revised Phase 26 spec — no OANDA provider.)
MARKET_PROVIDER="deriv"
# Deriv — candles come from the PUBLIC, no-auth WebSocket
# (wss://api.derivws.com/trading/v1/options/ws/public), so market data works
# with these left empty.
#   DERIV_APP_ID    — your Deriv app id (used for the legacy WS fallback).
#   DERIV_API_TOKEN — Deriv Personal Access Token (pat_…). Used for the
#                     server-side credential check at worker startup, where
#                     `Authorization: Bearer <token>` + `Deriv-App-ID` headers
#                     are sent to https://api.derivws.com (REST).
DERIV_APP_ID=""
DERIV_API_TOKEN=""
# TwelveData — REST-only fallback. Free plan limited to 8 requests/minute and 800/day;
# the worker enforces these via a rate limiter + request budget tracker.
TWELVEDATA_API_KEY=""
# Cap on watchlist size — users cannot add unlimited pairs (config-driven).
MARKET_WATCHLIST_MAX_PAIRS="20"

# ──────────────────────────────────────────────────────────────────────────────
# Phase 30.1 — Agentic news pipeline (worker only; never read in the browser)
# ──────────────────────────────────────────────────────────────────────────────
# Off by default — all AI features are opt-in. Set to "true" to enable the
# bounded harvest → dedupe → Groq classify → store loop in `bun run worker`.
NEWS_AGENT_ENABLED="false"
# Bounded loop: max listing pages per run / max articles stored per run /
# max bytes per fetched page / per-fetch timeout / min gap between requests
# to the same domain / cadence between runs.
NEWS_AGENT_MAX_PAGES="4"
NEWS_AGENT_MAX_ITEMS="20"
NEWS_AGENT_MAX_BYTES="200000"
NEWS_AGENT_TIMEOUT_MS="10000"
NEWS_AGENT_DOMAIN_INTERVAL_MS="1000"
NEWS_AGENT_INTERVAL_MS="1800000"
# Comma-separated allowlist ids: fed, ecb, boe, forexfactory, investing.
# Empty = all sources in src/lib/news/sources.ts. Unknown ids are ignored.
NEWS_AGENT_SOURCES=""
# Economic-calendar provider (existing seam). Articles come from the agent.
NEWS_PROVIDER="finnhub"
FINNHUB_API_KEY=""
