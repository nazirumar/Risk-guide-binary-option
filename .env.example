# ──────────────────────────────────────────────────────────────────────────────
# RiskGuard environment template — copy to `.env` and fill in real values.
# Never commit the real `.env` file.
# ──────────────────────────────────────────────────────────────────────────────

# Database (SQLite for local sandbox dev by default).
# To switch to Postgres, set this to the connection string of your Postgres instance
# (e.g. postgres://riskguard:riskguard_dev_password@localhost:5432/riskguard).
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Next.js / Auth.js
NEXTAUTH_URL="http://localhost:3000"
# Generate with: `openssl rand -base64 32` (or `bun run scripts/generate-secret.ts`)
NEXTAUTH_SECRET="dev-only-secret-change-me-in-production"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Phase 25: renamed from GOOGLE_CLIENT_ID/SECRET → AUTH_GOOGLE_ID/SECRET per
# spec. The old names still work for backward compatibility, but new
# deployments should use the AUTH_GOOGLE_* names.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# (Deprecated aliases — still honored by src/lib/auth.ts but discouraged.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (transactional email) — https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="RiskGuard <onboarding@resend.dev>"

# Upstash Redis (rate limiting) — https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# App config
APP_NAME="RiskGuard"
APP_TIMEZONE="UTC"
DEFAULT_BASE_CURRENCY="USD"
NODE_ENV="development"

# ──────────────────────────────────────────────────────────────────────────────
# Phase 26 — Market data provider
# ──────────────────────────────────────────────────────────────────────────────
# Provider switch ("deriv" | "twelvedata").
# Deriv is the default for this phase: OANDA is not available in Nigeria.
# (Revised Phase 26 spec — no OANDA provider.)
MARKET_PROVIDER="deriv"
# Deriv — candles come from the PUBLIC, no-auth WebSocket
# (wss://api.derivws.com/trading/v1/options/ws/public), so market data works
# with these left empty.
#   DERIV_APP_ID    — your Deriv app id (used for the legacy WS fallback).
#   DERIV_API_TOKEN — Deriv Personal Access Token (pat_…). Used for the
#                     server-side credential check at worker startup, where
#                     `Authorization: Bearer <token>` + `Deriv-App-ID` headers
#                     are sent to https://api.derivws.com (REST).
DERIV_APP_ID=""
DERIV_API_TOKEN=""
# TwelveData — REST-only fallback. Free plan limited to 8 requests/minute and 800/day;
# the worker enforces these via a rate limiter + request budget tracker.
TWELVEDATA_API_KEY=""
# Cap on watchlist size — users cannot add unlimited pairs (config-driven).
MARKET_WATCHLIST_MAX_PAIRS="20"
